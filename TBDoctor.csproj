<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TBDoctor</AssemblyName>
    <RootNamespace>DemolitionJobDoctor</RootNamespace>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />

  </ItemGroup>
  <Import Project="refs/ReferenceAssemblies.props" Condition="Exists('refs/ReferenceAssemblies.props')" />
  <Target Name="RequireGenuineReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('refs/ReferenceAssemblies.props')" Text="Real game references required: run scripts/prepare_refs.py first." />
  </Target>
</Project>
